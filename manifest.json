{
  "manifest_version": 3,
  "name": "Busca de Jurisprudência (TJRS, TRF4, STJ, STF)",
  "version": "1.4.0",
  "description": "Pesquisa rápida de jurisprudência nos portais do TJRS, TRF4, STJ e STF.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.tjrs.jus.br/*",
    "https://jurisprudencia.trf4.jus.br/*",
    "https://scon.stj.jus.br/*",
    "https://jurisprudencia.stf.jus.br/*"
  ],
  "omnibox": {
    "keyword": "juris"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://jurisprudencia.trf4.jus.br/*"],
      "js": ["trf4-content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pesquisar Jurisprudência (Alt+J)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Alt+J"
      },
      "description": "Abrir pesquisa de jurisprudência"
    }
  }
}